<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent plist for iphone-use daemon.
  Label and filename MUST match: com.leeguoo.iphone-use
  Bundle id stays stable across upgrades. TCC identity matters only when the
  explicit legacy mirror backend is used.

  This file is a TEMPLATE.  install.sh generates the live copy under
  ~/Library/LaunchAgents/com.leeguoo.iphone-use.plist by substituting
  __HOME__ with the actual $HOME value.  Do not load this template directly.
-->
<plist version="1.0">
<dict>
    <!-- Stable reverse-DNS label — equals CFBundleIdentifier -->
    <key>Label</key>
    <string>com.leeguoo.iphone-use</string>

    <!-- Absolute path to binary inside the .app + subcommand -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/iPhoneUse.app/Contents/MacOS/iphone-use</string>
        <string>serve</string>
    </array>

    <!-- Start immediately when the Aqua session boots -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash; launchd throttles relaunches to ≥10 s -->
    <key>KeepAlive</key>
    <true/>

    <!-- Logs — install.sh creates the parent dir before loading -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/iPhoneUse/iphone-use.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/iPhoneUse/iphone-use.err</string>

    <!--
      Interactive: scheduling hint for a GUI foreground-class process.
      Does NOT affect TCC — it only controls CPU scheduling bucket.
    -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!--
      Aqua: install as the signed-in user's LaunchAgent, not a system daemon.
      Direct/WDA itself does not need WindowServer capture; the explicit legacy
      mirror backend still requires this session for ScreenCaptureKit.
    -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
        <!-- Remote browsers/agents reach the daemon over the LAN, so this
             template binds 0.0.0.0. A password is mandatory for that binding;
             install.sh generates one when none is supplied. -->
        <key>PHONE_REMOTE_HOST</key>
        <string>0.0.0.0</string>
        <key>PHONE_REMOTE_PORT</key>
        <string>44321</string>
        <key>PHONE_REMOTE_PASSWORD</key>
        <string>__PASSWORD__</string>
        <!-- Direct/WDA is the default. The installer owns these loopback USB
             relays; custom or remote WDA endpoints must set managed=false. -->
        <key>PHONE_REMOTE_BACKEND</key>
        <string>direct</string>
        <key>PHONE_REMOTE_WDA_URL</key>
        <string>http://127.0.0.1:8100</string>
        <key>PHONE_REMOTE_WDA_MJPEG_URL</key>
        <string>http://127.0.0.1:9100</string>
        <key>PHONE_REMOTE_WDA_MANAGED</key>
        <string>true</string>
    </dict>
</dict>
</plist>
