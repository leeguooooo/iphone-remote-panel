<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent plist for iphone-use daemon.
  Label and filename MUST match: com.leeguoo.iphone-use
  Bundle id is stable so TCC grants survive upgrades.

  This file is a TEMPLATE.  install.sh generates the live copy under
  ~/Library/LaunchAgents/com.leeguoo.iphone-use.plist by substituting
  __HOME__ with the actual $HOME value.  Do not load this template directly.
-->
<plist version="1.0">
<dict>
    <!-- Stable reverse-DNS label — equals CFBundleIdentifier -->
    <key>Label</key>
    <string>com.leeguoo.iphone-use</string>

    <!-- Absolute path to binary inside the .app + subcommand -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/iPhoneUse.app/Contents/MacOS/iphone-use</string>
        <string>serve</string>
    </array>

    <!-- Start immediately when the Aqua session boots -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash; launchd throttles relaunches to ≥10 s -->
    <key>KeepAlive</key>
    <true/>

    <!-- Logs — install.sh creates the parent dir before loading -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/iPhoneUse/iphone-use.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/iPhoneUse/iphone-use.err</string>

    <!--
      Interactive: scheduling hint for a GUI foreground-class process.
      Does NOT affect TCC — it only controls CPU scheduling bucket.
    -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!--
      Aqua: only load in a desktop GUI session (not in SSH / system session 0).
      Required so the daemon has a WindowServer connection for ScreenCaptureKit.
    -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
        <!-- The iPhone reaches the daemon over the LAN, so bind 0.0.0.0 (the
             daemon's own default is 127.0.0.1, which the phone can't reach).
             A password is mandatory when bound to the LAN. install.sh fills
             these in (generating a password if none is supplied). -->
        <key>PHONE_REMOTE_HOST</key>
        <string>0.0.0.0</string>
        <key>PHONE_REMOTE_PORT</key>
        <string>8787</string>
        <key>PHONE_REMOTE_PASSWORD</key>
        <string>__PASSWORD__</string>
    </dict>
</dict>
</plist>
