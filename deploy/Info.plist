<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for iPhoneUse.app bundle.
  Placed at: iPhoneUse.app/Contents/Info.plist by scripts/make-app.sh.

  CFBundleIdentifier MUST stay "com.leeguoo.iphone-use" across all releases
  so that TCC (Screen Recording + Accessibility) grants persist.  Changing it
  forces every user to re-grant.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.leeguoo.iphone-use</string>

    <key>CFBundleName</key>
    <string>iPhoneUse</string>

    <key>CFBundleDisplayName</key>
    <string>iphone-use</string>

    <!-- Must match the binary filename inside Contents/MacOS/ -->
    <key>CFBundleExecutable</key>
    <string>iphone-use</string>

    <!-- App icon — Resources/AppIcon.icns, copied in by make-app.sh -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <!-- Versioning — injected at build time by make-app.sh / CI from Cargo.toml -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!--
      Required for ScreenCaptureKit / CGDisplayStream access.
      macOS shows this string in the Screen Recording permission dialog.
    -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>iphone-use needs to capture the iPhone Mirroring window to stream it to your iPhone over WebRTC.</string>

    <!--
      Required for CGEventPost (Accessibility) used to drive pointer input
      into the iPhone Mirroring window.
    -->
    <key>NSAppleEventsUsageDescription</key>
    <string>iphone-use needs Accessibility access to inject touch events into iPhone Mirroring.</string>

    <!-- Suppress Dock icon — daemon runs in background -->
    <key>LSUIElement</key>
    <true/>

    <!-- Allow running from user's ~/Applications as well as /Applications -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>
</dict>
</plist>
