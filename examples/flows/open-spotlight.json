{
  "version": 1,
  "name": "Open Spotlight",
  "description": "Safe navigation example: return home, open Spotlight, and require its text field.",
  "app": "com.apple.springboard",
  "category": "system",
  "risk": "navigation",
  "steps": [
    {
      "kind": "shortcut",
      "name": "home",
      "after_ms": 300
    },
    {
      "kind": "shortcut",
      "name": "spotlight"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "kind": "TextField"
          }
        ]
      },
      "timeout_ms": 15000,
      "poll_ms": 100
    }
  ]
}
